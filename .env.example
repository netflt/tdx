# TDX 股票数据 API 服务配置
# 复制为 .env 后修改: cp .env.example .env

# ==========================================
# 服务配置
# ==========================================
TDX_PORT=8080
TDX_DIR=data

# ==========================================
# MySQL 服务配置 (与 db.yml 保持一致)
# ==========================================
MYSQL_CONTAINER=vnpy-mysql-prod
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=YourStrongPassword123!
MYSQL_DATABASE=vnpy_db
MYSQL_USER=vnpy
MYSQL_PASSWORD=Ecallcen

# ==========================================
# TDX 数据库连接
# 本地部署: DB_HOST=127.0.0.1, DB_PORT=3307
# Docker部署: DB_HOST=mysql-server, DB_PORT=3306
# ==========================================
DB_TYPE=mysql
DB_HOST=192.168.5.4
DB_PORT=3307
DB_USER=vnpy
DB_PASSWORD=Ecallcen
DB_NAME=vnpy_db

# MySQL DSN (自动拼接,也可直接覆盖)
# DB_DSN=vnpy:Ecallcen@tcp(127.0.0.1:3307)/vnpy_db?charset=utf8mb4&parseTime=true&loc=Local
